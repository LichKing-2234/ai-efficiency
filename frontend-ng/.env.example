# Backend API origin used by the TanStack server-side proxy.
# Local dev usually points to a local Go backend. Deployed frontend-ng should
# set the same variable to a backend origin reachable by both the frontend
# server and developer machines when /oauth2/local handoff is used.
# If you want localhost to reuse an already logged-in online session instead of
# a local Go backend, set this to the deployed frontend-ng web origin, for
# example:
# AE_FRONTEND_BACKEND_URL=https://ai-efficiency-web.la3.agoralab.co
AE_FRONTEND_BACKEND_URL=http://127.0.0.1:8081
