# -----------------------------------------------------------------------------
# Operator Configuration
# -----------------------------------------------------------------------------
# This file intentionally contains only operator-facing values.
# Docker image/runtime defaults are provided in the compose files and docker-deploy.sh.
# Docker Compose and systemd launch only ai-efficiency-server. The optional
# prewarmer's initial deployment path is Helm.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
AE_SERVER_PORT=8081
AE_SERVER_FRONTEND_URL=http://localhost:8081
AE_SERVER_PUBLIC_URL=http://localhost:8081
AE_METRICS_LISTEN_ADDRESS=:9090

# -----------------------------------------------------------------------------
# Bundled PostgreSQL (used by deploy/docker-compose*.yml bundled stacks)
# docker-deploy.sh will auto-generate POSTGRES_PASSWORD if blank.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_efficiency

# -----------------------------------------------------------------------------
# Bundled Redis (used by deploy/docker-compose*.yml bundled stacks)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# External Infra (used by deploy/docker-compose.external.yml)
# -----------------------------------------------------------------------------
AE_DB_DSN=postgres://postgres:postgres@postgres:5432/ai_efficiency?sslmode=disable
AE_REDIS_ADDR=redis:6379
AE_REDIS_PASSWORD=
AE_REDIS_DB=0
AE_REDIS_NAMESPACE=ai-efficiency

# -----------------------------------------------------------------------------
# Relay
# -----------------------------------------------------------------------------
AE_RELAY_URL=http://sub2api.example.com
AE_RELAY_ADMIN_API_KEY=

# Attribution protocol. Change only as part of the explicit v2 cutover runbook.
AE_ATTRIBUTION_LEDGER_EPOCH=shadow_v2
AE_ATTRIBUTION_V1_WRITE_POLICY=accept
AE_ATTRIBUTION_MINIMUM_CLI_VERSION=
AE_ATTRIBUTION_CUTOVER_AT=
AE_ATTRIBUTION_SETUP_AVAILABLE=false
AE_ATTRIBUTION_READINESS_AVAILABLE=false

# -----------------------------------------------------------------------------
# Version Check
# Enables read-only current/backend-latest version display in the admin UI.
# This does not enable in-app binary upgrade, rollback, or restart.
# -----------------------------------------------------------------------------
AE_VERSION_CHECK_ENABLED=true
AE_VERSION_CHECK_RELEASE_API_URL=https://api.github.com/repos/LichKing-2234/ai-efficiency/releases/latest

# -----------------------------------------------------------------------------
# LDAP
# -----------------------------------------------------------------------------
AE_AUTH_LDAP_URL=
AE_AUTH_LDAP_BASE_DN=
AE_AUTH_LDAP_BIND_DN=
AE_AUTH_LDAP_BIND_PASSWORD=
AE_AUTH_LDAP_USER_FILTER=(uid=%s)
AE_AUTH_LDAP_TLS=false

# -----------------------------------------------------------------------------
# Runtime State
# When AE_CONFIG_PATH is unset, runtime-editable settings are stored under
# AE_STATE_DIR/config.yaml inside the mounted app state volume.
# -----------------------------------------------------------------------------
AE_STATE_DIR=/var/lib/ai-efficiency

# -----------------------------------------------------------------------------
# Security
# docker-deploy.sh will auto-generate these if they are blank.
# -----------------------------------------------------------------------------
AE_AUTH_JWT_SECRET=
AE_ENCRYPTION_KEY=
