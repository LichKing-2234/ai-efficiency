{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_http_request_duration_seconds_bucket{release=~\"$release\",route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_http_request_duration_seconds_bucket{release=~\"$release\",route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, dependency, release) (rate(ai_efficiency_dependency_request_duration_seconds_bucket{release=~\"$release\"}[$__rate_interval])))",
          "legendFormat": "p75 {{dependency}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, dependency, release) (rate(ai_efficiency_dependency_request_duration_seconds_bucket{release=~\"$release\"}[$__rate_interval])))",
          "legendFormat": "p95 {{dependency}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "Dependency Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"LCP\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"LCP\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "LCP",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"INP\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"INP\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "INP",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"TTFB\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_seconds_bucket{metric=\"TTFB\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "TTFB",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 8 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_ratio_bucket{metric=\"CLS\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_browser_web_vital_ratio_bucket{metric=\"CLS\",release=~\"$release\",route=~\"$browser_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "CLS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        { "expr": "ai_efficiency_db_connections", "legendFormat": "connections {{state}}", "refId": "A" },
        { "expr": "rate(ai_efficiency_db_wait_total[$__rate_interval])", "legendFormat": "waits/s", "refId": "B" },
        { "expr": "rate(ai_efficiency_db_wait_duration_seconds_total[$__rate_interval])", "legendFormat": "wait seconds/s", "refId": "C" },
        { "expr": "rate(ai_efficiency_db_connections_closed_total[$__rate_interval])", "legendFormat": "closed/s {{reason}}", "refId": "D" }
      ],
      "title": "Database Pool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "targets": [
        { "expr": "ai_efficiency_redis_pool_connections", "legendFormat": "pool {{state}}", "refId": "A" },
        { "expr": "rate(ai_efficiency_redis_pool_wait_total[$__rate_interval])", "legendFormat": "waits/s", "refId": "B" },
        { "expr": "rate(ai_efficiency_redis_pool_wait_duration_seconds_total[$__rate_interval])", "legendFormat": "wait seconds/s", "refId": "C" },
        { "expr": "rate(ai_efficiency_redis_pool_timeout_total[$__rate_interval])", "legendFormat": "timeouts/s", "refId": "D" },
        { "expr": "rate(ai_efficiency_redis_pool_stale_connections_total[$__rate_interval])", "legendFormat": "stale removed/s", "refId": "E" }
      ],
      "title": "Redis Pool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (cache, outcome) (rate(ai_efficiency_cache_events_total[$__rate_interval]))",
          "legendFormat": "{{cache}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Application Cache",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "id": 10,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, route, release) (rate(ai_efficiency_http_response_bytes_bucket{release=~\"$release\",route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "p75 {{route}} {{release}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, release) (rate(ai_efficiency_http_response_bytes_bucket{release=~\"$release\",route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}} {{release}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Response Size",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ai-efficiency", "performance", "baseline"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "includeAll": true,
        "label": "Release",
        "name": "release",
        "query": { "query": "label_values(ai_efficiency_http_requests_total, release)", "refId": "release" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "includeAll": true,
        "label": "HTTP Route",
        "name": "http_route",
        "query": { "query": "label_values(ai_efficiency_http_requests_total{release=~\"$release\"}, route)", "refId": "http_route" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "includeAll": true,
        "label": "Browser Route",
        "name": "browser_route",
        "query": { "query": "label_values(ai_efficiency_browser_web_vital_seconds_bucket{release=~\"$release\"}, route)", "refId": "browser_route" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "AI Efficiency Performance Baseline",
  "uid": "ai-efficiency-performance",
  "version": 1
}
